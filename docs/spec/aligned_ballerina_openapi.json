    "paths": {
        "/v1/organizations/{organizationId}/stream": {
            "get": {
                "tags": [
                    "DataSet"
                ],
                "summary": "Get the monitoring event stream",
                "description": "Retrieves a page of Docusign Monitor events from the organization data set. Pass the cursor from a previous response to continue reading the stream.",
                "operationId": "getStream",
                "parameters": [
                    {
                        "name": "organizationId",
                        "in": "path",
                        "description": "The unique identifier of the organization whose events are retrieved",
                        "required": true,
                        "style": "simple",
                        "explode": false,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    },
                    {
                        "name": "cursor",
                        "in": "query",
                        "description": "A location in the DataSet  that continues querying data",
                        "required": false,
                        "style": "form",
                        "explode": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "description": "Maximum number of results to return",
                        "required": false,
                        "style": "form",
                        "explode": true,
                        "schema": {
                            "type": "integer",
                            "format": "int32"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "A page of monitoring events together with the cursor for the next page.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/StreamResponse"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "OAuth2": []
                    }
                ],
                "x-ds-methodname": "getStream",
                "x-ds-method": "getStream",
                "x-ds-service": "DocuMonitor",
                "x-ds-in-sdk": true
            }
        }
